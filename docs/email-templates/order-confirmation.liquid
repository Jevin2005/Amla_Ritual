<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title>Your NatureMist Order Confirmation — Private Tracking ID: {{ order.id }}</title>
  <!--[if mso]>
  <noscript>
    <xml>
      <o:OfficeDocumentSettings>
        <o:PixelsPerInch>96</o:PixelsPerInch>
      </o:OfficeDocumentSettings>
    </xml>
  </noscript>
  <![endif]-->
  <style>
    body, table, td, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      min-width: 100%;
      background-color: #f7f5f0;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1a231e;
      line-height: 1.5;
    }
    @media only screen and (max-width: 620px) {
      .email-container {
        width: 100% !important;
        max-width: 100% !important;
        border-radius: 0 !important;
        border-left: none !important;
        border-right: none !important;
      }
      .content-padding {
        padding: 24px 20px !important;
      }
      .stack-column {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        box-sizing: border-box;
      }
      .stack-spacing {
        padding-top: 16px !important;
      }
    }
  </style>
</head>
<body style="margin: 0; padding: 0; background-color: #f7f5f0;">
  <!-- Preview Text -->
  <div style="display: none; font-size: 1px; color: #f7f5f0; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden;">
    Your NatureMist order has been confirmed. Private Tracking ID: {{ order.id }}.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color: #f7f5f0;">
    <tr>
      <td align="center" style="padding: 32px 12px;">

        <!-- Main Card Container -->
        <table role="presentation" class="email-container" width="600" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 600px; background-color: #ffffff; border: 1px solid #e6e2d8; border-radius: 12px; overflow: hidden;">
          
          <!-- Header Banner -->
          <tr>
            <td align="center" style="background-color: #142f24; padding: 36px 24px 30px; text-align: center;">
              <a href="https://www.naturemist.shop" target="_blank" style="text-decoration: none; display: inline-block;">
                <span style="font-family: Georgia, 'Times New Roman', serif; font-size: 24px; font-weight: 400; color: #ffffff; letter-spacing: 0.2em; text-transform: uppercase; display: block;">
                  NatureMist
                </span>
                <span style="font-size: 10px; color: #a4bea8; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 500; display: block; margin-top: 6px;">
                  Pure Botanicals &bull; Powerful Rituals
                </span>
              </a>
            </td>
          </tr>

          <!-- Metadata Strip: Displays Unique Private Tracking ID -->
          <tr>
            <td style="background-color: #faf8f3; border-bottom: 1px solid #edeae1; padding: 14px 28px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="left" style="font-size: 12px; color: #647366; text-transform: uppercase; letter-spacing: 0.08em;">
                    Private Tracking ID: <strong style="color: #142f24; font-family: Consolas, Monaco, monospace; letter-spacing: 0.06em;">{{ order.id }}</strong>
                  </td>
                  <td align="right" style="font-size: 12px; color: #647366;">
                    {{ order.created_at | date: "%B %d, %Y" }}
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Primary Body Content -->
          <tr>
            <td class="content-padding" style="padding: 36px 32px 28px;">
              
              <h1 style="margin: 0 0 14px; font-family: Georgia, 'Times New Roman', serif; font-size: 24px; font-weight: 400; color: #142f24; line-height: 1.3;">
                Thank you for your order, {{ customer.first_name | default: "friend" }}.
              </h1>
              
              <p style="margin: 0 0 24px; font-size: 14px; line-height: 1.65; color: #4e5c51;">
                We have received your order and our laboratory team has begun preparing your freshly milled botanical formulations. You can view your real-time preparation progress on our website using your <strong>Private Tracking ID</strong>. Once your package is dispatched, you will receive a separate update with your <strong>Courier Tracking ID</strong>.
              </p>

              <!-- App Tracking Action Button with Unique Private Tracking ID -->
              {% assign storefront_track_url = "https://www.naturemist.shop/track-order?ref=" | append: order.id %}
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin: 0 0 32px;">
                <tr>
                  <td align="left">
                    <!--[if mso]>
                    <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ storefront_track_url }}" style="height:44px;v-text-anchor:middle;width:250px;" arcsize="18%" stroke="f" fillcolor="#142f24">
                      <w:anchorlock/>
                      <center style="color:#ffffff;font-family:sans-serif;font-size:13px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;">Track Order On Our Website</center>
                    </v:roundrect>
                    <![endif]-->
                    <a href="{{ storefront_track_url }}" target="_blank" style="mso-hide:all; display: inline-block; background-color: #142f24; color: #ffffff; text-decoration: none; font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; padding: 14px 28px; border-radius: 8px; text-align: center;">
                      Track Order On Our Website &rarr;
                    </a>
                  </td>
                </tr>
              </table>

              <!-- Section Divider -->
              <div style="height: 1px; background-color: #edeae1; margin-bottom: 28px;"></div>

              <!-- Product Line Items -->
              <h2 style="margin: 0 0 18px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #142f24;">
                Order Summary
              </h2>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                {% for line in line_items %}
                  <!-- Bulletproof Real Image Resolution -->
                  {% assign item_image_url = nil %}
                  {% if line.image %}
                    {% assign item_image_url = line.image | img_url: 'compact_cropped' %}
                  {% elsif line.product.featured_image %}
                    {% assign item_image_url = line.product.featured_image | img_url: 'compact_cropped' %}
                  {% elsif line.variant.image %}
                    {% assign item_image_url = line.variant.image | img_url: 'compact_cropped' %}
                  {% elsif line.variant.featured_image %}
                    {% assign item_image_url = line.variant.featured_image | img_url: 'compact_cropped' %}
                  {% elsif line | img_url: 'compact_cropped' %}
                    {% assign item_image_url = line | img_url: 'compact_cropped' %}
                  {% endif %}

                  {% if item_image_url == blank or item_image_url contains 'no-image' %}
                    {% for prop in line.properties %}
                      {% if prop.first == '_image_url' or prop.name == '_image_url' %}
                        {% assign item_image_url = prop.last | default: prop.value %}
                      {% endif %}
                    {% endfor %}
                  {% endif %}

                  {% assign product_url = "https://www.naturemist.shop/shop" %}
                  {% if line.product.handle %}
                    {% assign product_url = "https://www.naturemist.shop/shop/" | append: line.product.handle %}
                  {% endif %}

                  <tr>
                    <!-- Real Product Image Column -->
                    <td width="72" valign="top" style="padding: 12px 0; border-bottom: 1px solid #f0ede6;">
                      <a href="{{ product_url }}" target="_blank" style="text-decoration: none; display: block;">
                        {% if item_image_url != blank and item_image_url != '' %}
                          <img src="{{ item_image_url }}" alt="{{ line.title | escape }}" width="68" height="68" border="0" style="display: block; width: 68px; height: 68px; border-radius: 8px; object-fit: cover; border: 1px solid #e6e2d8; background-color: #f9f8f5;">
                        {% else %}
                          <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="68" height="68" style="width: 68px; height: 68px; background-color: #f3f0e8; border-radius: 8px; border: 1px solid #e6e2d8; text-align: center;">
                            <tr>
                              <td align="center" valign="middle" style="font-size: 20px; color: #7f9082; font-family: Georgia, serif;">&#10047;</td>
                            </tr>
                          </table>
                        {% endif %}
                      </a>
                    </td>

                    <!-- Product Description Column (Linked to app product page) -->
                    <td valign="top" style="padding: 12px 14px; border-bottom: 1px solid #f0ede6;">
                      <a href="{{ product_url }}" target="_blank" style="text-decoration: none; font-size: 14px; font-weight: 600; color: #142f24; line-height: 1.4; display: block;">
                        {{ line.title }}
                      </a>
                      
                      {% if line.variant.title and line.variant.title != 'Default Title' %}
                        <div style="font-size: 12px; color: #69786c; margin-top: 3px;">
                          {{ line.variant.title }}
                        </div>
                      {% endif %}

                      <div style="font-size: 12px; color: #879489; margin-top: 4px;">
                        Qty: <strong style="color: #435146;">{{ line.quantity }}</strong>
                      </div>
                    </td>

                    <!-- Product Price Column -->
                    <td width="90" valign="top" align="right" style="padding: 12px 0; border-bottom: 1px solid #f0ede6; font-size: 14px; font-weight: 600; color: #142f24; white-space: nowrap;">
                      {{ line.final_line_price | money }}
                    </td>
                  </tr>
                {% endfor %}
              </table>

              <!-- Totals Breakdown Table -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-top: 18px; font-size: 14px;">
                <tr>
                  <td style="padding: 6px 0; color: #5b695e;">Subtotal</td>
                  <td align="right" style="padding: 6px 0; color: #142f24; font-weight: 500;">
                    {{ order.subtotal_price | money }}
                  </td>
                </tr>

                {% for discount_application in order.discount_applications %}
                  <tr>
                    <td style="padding: 6px 0; color: #2e6b3e;">Discount ({{ discount_application.title }})</td>
                    <td align="right" style="padding: 6px 0; color: #2e6b3e; font-weight: 600;">
                      -{{ discount_application.total_allocated_amount | money }}
                    </td>
                  </tr>
                {% endfor %}

                <tr>
                  <td style="padding: 6px 0; color: #5b695e;">Shipping</td>
                  <td align="right" style="padding: 6px 0; color: #142f24;">
                    {% if order.shipping_price == 0 %}
                      <span style="color: #2e6b3e; font-weight: 600;">Free</span>
                    {% else %}
                      {{ order.shipping_price | money }}
                    {% endif %}
                  </td>
                </tr>

                {% if order.tax_price > 0 %}
                  <tr>
                    <td style="padding: 6px 0; color: #5b695e;">Estimated Taxes</td>
                    <td align="right" style="padding: 6px 0; color: #142f24;">
                      {{ order.tax_price | money }}
                    </td>
                  </tr>
                {% endif %}

                <tr>
                  <td style="padding: 14px 0 6px; border-top: 1px solid #142f24; font-size: 16px; font-weight: 700; color: #142f24;">
                    Total
                  </td>
                  <td align="right" style="padding: 14px 0 6px; border-top: 1px solid #142f24; font-size: 17px; font-weight: 700; color: #142f24;">
                    {{ order.total_price | money }}
                  </td>
                </tr>
              </table>

              <!-- Customer & Delivery Information Grid -->
              <div style="margin-top: 36px; padding-top: 24px; border-top: 1px solid #edeae1;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                  <tr>
                    <!-- Shipping Address Column -->
                    <td class="stack-column" width="48%" valign="top">
                      <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #142f24; margin-bottom: 8px;">
                        Delivery Address
                      </div>
                      {% if order.shipping_address %}
                        <div style="font-size: 13px; line-height: 1.5; color: #526156;">
                          <strong style="color: #142f24;">{{ order.shipping_address.name }}</strong><br>
                          {{ order.shipping_address.street }}<br>
                          {{ order.shipping_address.city }}, {{ order.shipping_address.province }} {{ order.shipping_address.zip }}<br>
                          {{ order.shipping_address.country }}<br>
                          {% if order.shipping_address.phone %}
                            <span style="font-size: 12px; color: #78857a;">Phone: {{ order.shipping_address.phone }}</span>
                          {% endif %}
                        </div>
                      {% else %}
                        <div style="font-size: 13px; color: #78857a;">
                          No shipping address specified.
                        </div>
                      {% endif %}
                    </td>

                    <!-- Spacer for desktop -->
                    <td width="4%" style="font-size: 1px; line-height: 1px;">&nbsp;</td>

                    <!-- Payment & Shipping Method Column -->
                    <td class="stack-column stack-spacing" width="48%" valign="top">
                      <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #142f24; margin-bottom: 8px;">
                        Payment & Method
                      </div>
                      <div style="font-size: 13px; line-height: 1.5; color: #526156;">
                        {% for transaction in order.transactions %}
                          <div style="margin-bottom: 4px;">
                            <strong style="color: #142f24;">{{ transaction.gateway_display_name | default: transaction.gateway | capitalize }}</strong>
                            {% if transaction.payment_details.credit_card_last4_digits %}
                              <br><span style="color: #78857a; font-size: 12px;">Ending in &bull;&bull;&bull;&bull; {{ transaction.payment_details.credit_card_last4_digits }}</span>
                            {% endif %}
                          </div>
                        {% else %}
                          <div style="margin-bottom: 4px;">
                            <strong style="color: #142f24;">{{ order.gateway | default: "Prepaid (Razorpay / UPI)" | capitalize }}</strong>
                          </div>
                        {% endfor %}
                        
                        <div style="margin-top: 10px;">
                          <span style="font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #142f24; display: block; margin-bottom: 2px;">Shipping Service</span>
                          <span style="font-size: 13px; color: #526156;">
                            {{ order.shipping_method.title | default: "Standard Botanical Delivery" }}
                          </span>
                        </div>
                      </div>
                    </td>
                  </tr>
                </table>
              </div>

            </td>
          </tr>

          <!-- Integrated Luxury Footer & Reassurance (Protected from Gmail trimming) -->
          <tr>
            <td style="background-color: #faf8f3; border-top: 1px solid #edeae1; padding: 26px 28px 28px; text-align: center;">
              
              <!-- Brand Pillars Strip -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom: 18px;">
                <tr>
                  <td align="center" style="font-size: 11px; color: #5b6c5e; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.6; font-weight: 600;">
                    Wildcrafted Harvest &bull; Small-Batch Milling &bull; Light-Protected Glass Jars
                  </td>
                </tr>
              </table>

              <!-- Subtle Divider -->
              <div style="height: 1px; background-color: #e6e2d7; max-width: 460px; margin: 0 auto 18px;"></div>

              <!-- Customer Care -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="font-size: 12px; color: #5b695e; line-height: 1.6;">
                    Have questions regarding your order or ritual preparation?<br>
                    Our herbal care team is available at <a href="mailto:care@naturemist.shop" style="color: #142f24; text-decoration: underline; font-weight: 600;">care@naturemist.shop</a>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding: 14px 0 10px; font-size: 12px;">
                    <a href="https://www.naturemist.shop/shop" target="_blank" style="color: #142f24; text-decoration: none; font-weight: 600; margin: 0 10px;">Shop Catalog</a> &bull;
                    <a href="https://www.naturemist.shop/rituals" target="_blank" style="color: #142f24; text-decoration: none; font-weight: 600; margin: 0 10px;">Ritual Finder</a> &bull;
                    <a href="https://www.naturemist.shop/track-order?ref={{ order.id }}" target="_blank" style="color: #142f24; text-decoration: none; font-weight: 600; margin: 0 10px;">Track Package</a>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="font-size: 11px; color: #8e9c91; padding-top: 6px;">
                    &copy; {{ "now" | date: "%Y" }} NatureMist Botanicals &bull; <a href="https://www.naturemist.shop" target="_blank" style="color: #7a8a7e; text-decoration: none;">naturemist.shop</a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

        </table>

        <!-- Unique Transaction Token (Prevents Gmail from collapsing footer into '...' trimmed content) -->
        <div style="display: none !important; mso-hide: all; font-size: 1px; color: #f7f5f0; line-height: 1px; max-height: 0px; max-width: 0px; opacity: 0; overflow: hidden;">
          &#8203; NatureMist Receipt Verification: {{ order.id }}-{{ "now" | date: "%s" }} &bull; https://www.naturemist.shop
        </div>

      </td>
    </tr>
  </table>
</body>
</html>
