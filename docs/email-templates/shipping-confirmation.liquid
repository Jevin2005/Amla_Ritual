<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Your NatureMist Package is on the Way</title>
  <style>
    body { margin: 0; padding: 0; background-color: #f6f4ed; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; color: #202b23; }
    table { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    td { padding: 0; }
    .email-container { width: 100%; max-width: 600px; margin: 24px auto; background-color: #ffffff; border-radius: 20px; overflow: hidden; border: 1px solid #e5e0d3; box-shadow: 0 4px 20px rgba(21, 59, 45, 0.05); }
    .hero-banner { background-color: #153b2d; text-align: center; padding: 40px 24px 32px; background-image: linear-gradient(180deg, #153b2d 0%, #0d281e 100%); }
    .brand-title { font-family: Georgia, serif; font-size: 28px; font-weight: 400; color: #ffffff; letter-spacing: 0.12em; text-transform: uppercase; margin: 0; }
    .brand-sub { font-size: 11px; color: #a7c943; text-transform: uppercase; letter-spacing: 0.18em; margin: 6px 0 0; font-weight: 600; }
    .main-body { padding: 36px 32px; }
    .status-pill { display: inline-block; background-color: #edf3dd; color: #3f7d3a; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; padding: 6px 14px; border-radius: 24px; margin-bottom: 16px; border: 1px solid #dce7ad; }
    .headline { font-family: Georgia, serif; font-size: 24px; font-weight: 400; color: #153b2d; margin: 0 0 12px; line-height: 1.25; }
    .intro-text { font-size: 14px; line-height: 1.65; color: #586359; margin: 0 0 28px; }
    
    /* Visual Milestone Progress Tracker */
    .tracker-box { background-color: #faf8f2; border: 1px solid #e7e2d4; border-radius: 16px; padding: 24px 20px; margin-bottom: 30px; }
    .step-label { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #153b2d; margin-top: 6px; }
    .step-label.pending { color: #9aa49a; }
    .step-circle { width: 32px; height: 32px; border-radius: 50%; display: inline-block; line-height: 32px; text-align: center; font-size: 14px; font-weight: bold; }
    .step-circle.done { background-color: #3f7d3a; color: #ffffff; }
    .step-circle.active { background-color: #153b2d; color: #ffffff; box-shadow: 0 0 0 4px #edf3dd; }
    .step-circle.next { background-color: #e5e0d3; color: #8c968b; }
    .step-line { height: 2px; background-color: #3f7d3a; width: 100%; display: block; }
    .step-line.next { background-color: #e5e0d3; }

    /* Waybill & Courier Card */
    .awb-card { background: #153b2d; border-radius: 14px; padding: 20px; color: #ffffff; margin-bottom: 28px; }
    .awb-label { font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; color: #a7c943; font-weight: 700; margin-bottom: 4px; }
    .awb-number { font-family: monospace; font-size: 18px; font-weight: 700; color: #ffffff; letter-spacing: 0.05em; }
    .awb-carrier { font-size: 13px; color: #d6e2b8; margin-top: 2px; }
    
    /* Primary CTA Button */
    .btn-track { display: block; width: 100%; max-width: 340px; margin: 24px auto 0; background-color: #3f7d3a; color: #ffffff !important; text-decoration: none; text-align: center; font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 16px 28px; border-radius: 50px; box-sizing: border-box; box-shadow: 0 4px 14px rgba(63, 125, 58, 0.35); }
    
    /* Product Items Section with Images */
    .items-header { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #153b2d; margin-bottom: 12px; border-bottom: 2px solid #153b2d; padding-bottom: 8px; }
    .item-table { width: 100%; }
    .item-row td { padding: 14px 0; border-bottom: 1px solid #f0ecdf; vertical-align: middle; }
    .item-img { width: 64px; height: 64px; border-radius: 10px; object-fit: cover; border: 1px solid #e7e2d4; display: block; }
    .item-title { font-size: 14px; font-weight: 600; color: #153b2d; margin: 0 0 4px; }
    .item-variant { font-size: 12px; color: #788577; margin: 0; }
    .item-price { font-size: 14px; font-weight: 700; color: #153b2d; text-align: right; }

    /* Ritual Advice Box */
    .ritual-box { background-color: #f7f9f2; border: 1px dashed #3f7d3a; border-radius: 12px; padding: 16px 18px; margin: 28px 0; font-size: 13px; color: #344838; line-height: 1.55; }

    /* Footer & Trust */
    .trust-strip { background-color: #faf8f2; padding: 22px 20px; border-top: 1px solid #e7e2d4; }
    .trust-pill { font-size: 11px; font-weight: 700; color: #153b2d; text-align: center; }
    .email-footer { background-color: #ffffff; padding: 30px 24px; text-align: center; font-size: 12px; color: #8c968b; line-height: 1.6; }
    .email-footer a { color: #3f7d3a; text-decoration: none; font-weight: 600; }
  </style>
</head>
<body>
  <table width="100%" bgcolor="#f6f4ed" cellpadding="0" cellspacing="0" border="0">
    <tr>
      <td align="center" style="padding: 24px 12px;">
        
        <div class="email-container">
          
          <!-- Grand Header Banner -->
          <div class="hero-banner">
            <h1 class="brand-title">NatureMist</h1>
            <p class="brand-sub">Pure Botanicals &bull; Powerful Rituals</p>
          </div>

          <!-- Main Content Area -->
          <div class="main-body">
            <span class="status-pill">&#10003; Handed to Priority Courier</span>
            <h2 class="headline">Your botanical package is on its way, {{ customer.first_name | default: "there" }}.</h2>
            <p class="intro-text">
              We have carefully measured, inspected, and sealed your fresh botanical powder in UV-protective glass jars. Your parcel has departed our formulation workshop.
            </p>

            <!-- Visual 4-Step Milestone Progress Bar -->
            <div class="tracker-box">
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td align="center" width="22%">
                    <div class="step-circle done">&#10003;</div>
                    <div class="step-label">Ordered</div>
                  </td>
                  <td width="4%"><span class="step-line"></span></td>
                  <td align="center" width="22%">
                    <div class="step-circle done">&#10003;</div>
                    <div class="step-label">Packed</div>
                  </td>
                  <td width="4%"><span class="step-line"></span></td>
                  <td align="center" width="22%">
                    <div class="step-circle active">&#128666;</div>
                    <div class="step-label" style="color: #3f7d3a;">Dispatched</div>
                  </td>
                  <td width="4%"><span class="step-line next"></span></td>
                  <td align="center" width="22%">
                    <div class="step-circle next">&#127969;</div>
                    <div class="step-label pending">Delivery</div>
                  </td>
                </tr>
              </table>
            </div>

            <!-- Prominent Tracking AWB Card -->
            <div class="awb-card">
              <table width="100%">
                <tr>
                  <td width="60%" style="vertical-align: middle;">
                    <div class="awb-label">Courier Waybill (AWB)</div>
                    <div class="awb-number">{{ fulfillment.tracking_number | default: "Scheduled for Pickup" }}</div>
                    <div class="awb-carrier">Carrier: <strong>{{ fulfillment.tracking_company | default: "Priority Express Air" }}</strong></div>
                  </td>
                  <td width="40%" style="text-align: right; vertical-align: middle;">
                    <div class="awb-label">Order Ref</div>
                    <div style="font-size: 16px; font-weight: 700; color: #ffffff;">{{ order.name }}</div>
                  </td>
                </tr>
              </table>

              <!-- Action Link to Next.js App -->
              <a href="https://www.naturemist.shop/track-order?ref={{ order.name | url_encode }}" class="btn-track" target="_blank">
                Track Live Milestones &rarr;
              </a>
            </div>

            <!-- Items with Real Dynamic Product Images -->
            <div style="margin-top: 36px;">
              <div class="items-header">Package Contents ({{ fulfillment.fulfillment_line_items.size }} Item{% if fulfillment.fulfillment_line_items.size > 1 %}s{% endif %})</div>
              <table class="item-table" cellpadding="0" cellspacing="0">
                {% for line in fulfillment.fulfillment_line_items %}
                  <tr class="item-row">
                    <!-- Dynamic Product Image -->
                    <td width="76" style="vertical-align: middle;">
                      {% if line.line_item.image %}
                        <img src="{{ line.line_item.image | image_url: width: 140, height: 140, crop: 'center' }}" alt="{{ line.line_item.title }}" class="item-img">
                      {% else %}
                        <div style="width: 64px; height: 64px; border-radius: 10px; background-color: #edf3dd; text-align: center; line-height: 64px; font-size: 26px; border: 1px solid #dce7ad;">&#127807;</div>
                      {% endif %}
                    </td>
                    <!-- Product Title & Details -->
                    <td style="padding-left: 10px; vertical-align: middle;">
                      <h4 class="item-title">{{ line.line_item.title }}</h4>
                      <p class="item-variant">
                        {% unless line.line_item.variant.title contains 'Default' %}
                          {{ line.line_item.variant.title }} &bull;
                        {% endunless %}
                        Quantity: <strong>{{ line.quantity }}</strong>
                      </p>
                    </td>
                    <!-- Line Total -->
                    <td class="item-price" style="vertical-align: middle;">
                      {{ line.line_item.final_line_price | money }}
                    </td>
                  </tr>
                {% endfor %}
              </table>
            </div>

            <!-- Real Shipping Address -->
            {% if order.shipping_address %}
              <div style="margin-top: 24px; padding: 18px; background-color: #faf8f2; border-radius: 12px; font-size: 13px; line-height: 1.5; color: #586359; border: 1px solid #e7e2d4;">
                <strong style="color: #153b2d; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; display: block; margin-bottom: 6px;">
                  Delivery Destination:
                </strong>
                <strong>{{ order.shipping_address.name }}</strong><br>
                {{ order.shipping_address.street }}<br>
                {{ order.shipping_address.city }}, {{ order.shipping_address.province }} &mdash; {{ order.shipping_address.zip }}<br>
                Phone: {{ order.shipping_address.phone | default: customer.phone | default: "On File" }}
              </div>
            {% endif %}

            <!-- Ritual Preparation Guide Tip -->
            <div class="ritual-box">
              <strong style="color: #153b2d; display: block; margin-bottom: 4px;">&#127807; Quick Ritual Tip While You Wait:</strong>
              When your jar arrives, blend 2–3 tablespoons of botanical powder with warm distilled water or rose water. Allow the paste to steep for 10 minutes before application for maximum nutrient absorption.
            </div>

          </div>

          <!-- Trust Badges Strip -->
          <div class="trust-strip">
            <table width="100%">
              <tr>
                <td class="trust-pill" width="33%">&#127807; 100% Single-Origin</td>
                <td class="trust-pill" width="33%">&#129514; Zero Preservatives</td>
                <td class="trust-pill" width="33%">&#128230; Plastic-Free Jar Packaging</td>
              </tr>
            </table>
          </div>

          <!-- Footer -->
          <div class="email-footer">
            <p style="margin: 0 0 10px;">
              Need help or have questions about your order?<br>
              Reply directly to this email or reach us at <a href="mailto:care@naturemist.com">care@naturemist.com</a>.
            </p>
            <p style="margin: 0; font-size: 11px; color: #a4aca3;">
              &copy; {{ "now" | date: "%Y" }} NatureMist Botanicals &bull; <a href="https://www.naturemist.shop">naturemist.shop</a>
            </p>
          </div>

        </div>

      </td>
    </tr>
  </table>
</body>
</html>
