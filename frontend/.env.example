# Optional public canonical origin used for metadata, social links, and the
# sitemap. Vercel deployments automatically use their system-provided domain.
SITE_URL=https://www.your-storefront-domain.com

# Shopify store hostname only (no protocol or path).
# Leave all Shopify values empty for the frontend-only preview catalog.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Exact custom Shopify checkout hostname. Keep this domain pointed at Shopify;
# never redirect the entire domain to the main storefront.
SHOPIFY_CHECKOUT_DOMAIN=checkout.naturemist.shop

# Recommended for this server-rendered storefront. Never expose this value in
# browser code or prefix it with NEXT_PUBLIC_.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Optional alternative when the Headless channel provides only a public token.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Pinned deliberately; review Shopify's quarterly release notes before changing.
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Default Shopify Market context for pricing, availability, and translations.
SHOPIFY_DEFAULT_COUNTRY=IN
SHOPIFY_DEFAULT_LANGUAGE=EN

# Dev Dashboard/Admin API app client secret used to sign Shopify webhooks.
SHOPIFY_WEBHOOK_SECRET=

# False keeps the site available with an empty live catalog if the catalog API
# fails; true throws at runtime when any Shopify catalog/content/policy operation
# fails. Production builds always use the safe fallback so a temporary Shopify
# outage or an unpublished policy cannot block deployment. Preview products are
# used only when Shopify is completely unconfigured.
SHOPIFY_STRICT_MODE=false

# Judge.me Product Reviews (Text, Photo, and Video Reviews)
# Set to 'true' to enable the interactive Judge.me review widget.
NEXT_PUBLIC_ENABLE_JUDGEME=true
# Defaults to SHOPIFY_STORE_DOMAIN if omitted
NEXT_PUBLIC_JUDGEME_SHOP_DOMAIN=your-store.myshopify.com
# From Judge.me Admin > Settings > Integrations > Developers > View API Tokens
NEXT_PUBLIC_JUDGEME_PUBLIC_TOKEN=

# Shopify's native cookie banner loads using SHOPIFY_STORE_DOMAIN and the shop ID
# returned by that store. Configure regions in Shopify > Settings > Customer privacy.
# The consent banner works independently of these optional analytics switches.
# Activate reporting only with an authorized release and verify real event receipt.
# Both switches below must be true for Shopify reporting; GA4 is optional.
# The master switch also controls loading Shopify's analytics destination script.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_ANALYTICS_HOSTS=naturemist.shop,www.naturemist.shop
NEXT_PUBLIC_SHOPIFY_ANALYTICS_ENABLED=false
# Set the GA4 web stream's public G- ID. Never put API secrets here.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

